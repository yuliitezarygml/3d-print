{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintForge Desktop",
  "version": "0.1.0",
  "identifier": "com.printforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrintForge Desktop",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "3D printing workshop management",
    "longDescription": "Offline-first order, inventory, printer and cost management for 3D printing workshops.",
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
